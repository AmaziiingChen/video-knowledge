{
  "name": "knowledgehub-desktop",
  "description": "A local-first knowledge workspace for macOS.",
  "author": "AmaziiingChen",
  "private": true,
  "version": "0.1.7",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prepare:macos-icons": "node scripts/prepare-macos-symbols.mjs",
    "dev": "npm run prepare:macos-icons && vite",
    "lint": "eslint src electron scripts *.config.js",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:components",
    "test:unit": "node --test",
    "test:components": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:reachability": "node scripts/check-source-reachability.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build": "npm run prepare:macos-icons && vite build && npm run check:bundle",
    "build:public-report": "vite build --config vite.public-report.config.js && node scripts/finalize-public-report-site.mjs",
    "preview:public-report": "vite preview --config vite.public-report.config.js",
    "preview": "vite preview",
    "desktop": "npm run build && npm run desktop:launch",
    "desktop:launch": "bash ../scripts/prepare_electron_macos.sh && electron electron/main.cjs",
    "desktop:backend": "python ../scripts/build_desktop_backend.py --target macos",
    "desktop:package": "npm run desktop:package:mac",
    "desktop:package:mac": "npm run build && npm run desktop:backend && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tabler/icons-vue": "3.44.0",
    "artplayer": "^5.4.0",
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "katex": "^0.16.47",
    "marked": "^18.0.6",
    "splitpanes": "^4.1.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "electron": "42.8.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "com.knowledgehub.desktop",
    "productName": "KnowledgeHub",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../desktop/backend/knowledgehub-backend",
        "to": "backend/knowledgehub-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "KnowledgeHub-${version}-${arch}.${ext}"
    }
  }
}
