{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test",
    "build": "vite build",
    "build:public-report": "vite build --config vite.public-report.config.js && node scripts/finalize-public-report-site.mjs",
    "preview:public-report": "vite preview --config vite.public-report.config.js",
    "preview": "vite preview",
    "desktop": "npm run build && npm run desktop:launch",
    "desktop:launch": "bash ../scripts/prepare_electron_macos.sh && electron electron/main.cjs",
    "desktop:backend": "python ../scripts/build_desktop_backend.py --target macos",
    "desktop:backend:mac": "python ../scripts/build_desktop_backend.py --target macos",
    "desktop:backend:win": "python ../scripts/build_desktop_backend.py --target windows",
    "desktop:package": "npm run desktop:package:mac",
    "desktop:package:mac": "npm run build && npm run desktop:backend:mac && electron-builder --mac dmg --arm64",
    "desktop:package:win": "npm run build && npm run desktop:backend:win && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tabler/icons-vue": "^3.44.0",
    "@tanstack/vue-table": "^8.21.3",
    "artplayer": "^5.4.0",
    "artplayer-plugin-thumbnail": "^1.0.3",
    "axios": "^1.18.1",
    "element-plus": "^2.14.3",
    "katex": "^0.16.47",
    "marked": "^18.0.6",
    "splitpanes": "^4.1.2",
    "vue": "^3.5.39"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "42.5.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.knowledgehub.desktop",
    "productName": "KnowledgeHub",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../desktop/backend/knowledgehub-backend",
        "to": "backend/knowledgehub-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "KnowledgeHub-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KnowledgeHub-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
